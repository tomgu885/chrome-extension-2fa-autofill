{
  "manifest_version": 3,
  "name": "本地验证器 · Local Authenticator",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "本地 TOTP 验证器：无限账号、自动填充、二维码导入、加密备份与 Chrome 加密同步。所有功能免费开放。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "本地验证器",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' data:; img-src 'self' data: blob:; base-uri 'none'; form-action 'none'"
  },
  "key": ""
}
